    <string name="about_title">Über die App</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_description">Freie Kamera-App ohne Google Play Services und ohne proprietäre Google-Dienste. Aufnahmen bleiben auf dem Gerät; die App überträgt nichts an einen Server.</string>
    <string name="about_suite">Teil der ConneXias Suite — vier eigenständige Apps (Warden, Files, Kamera, Galerie), die über Android-Intents zusammenarbeiten, aber jede für sich allein voll funktionsfähig bleiben.</string>
    <string name="about_updates_title">Updates</string>
